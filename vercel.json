{
  "redirects": [
    { "source": "/", "destination": "/frontend/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{data/**,ml/benchmark.json,contracts/sample/**}",
      "maxDuration": 60
    }
  }
}
